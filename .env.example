APP_ENV=development
LOG_LEVEL=INFO
API_TOKEN=replace-with-a-long-random-secret
REDIS_URL=redis://redis:6379/2
JOB_BACKEND=redis
OCR_MODEL_PROFILE=mobile
OCR_MAX_CONCURRENT_JOBS=1
OCR_MAX_UPLOAD_MB=50
OCR_MAX_PAGES_PER_JOB=30
OCR_RENDER_DPI=250
OCR_MAX_IMAGE_PIXELS=30000000
OCR_JOB_TIMEOUT_SECONDS=600
OCR_RESULT_TTL_HOURS=72
OCR_TEMP_DIR=/tmp/ocr
OCR_MAX_QUEUED_JOBS=100
OCR_ALLOWED_OBJECT_PREFIX=archives/
OCR_OBJECT_STORE_DIR=/tmp/ocr-objects
PROMETHEUS_METRICS_TOKEN=

